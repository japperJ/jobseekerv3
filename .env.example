# Copy to .env and adjust.
# Port for the local web app
PORT=4173

# Model used for all AI work, as <provider>/<model>.
# The provider prefix selects the backend: github-copilot (default) or opencode.
LLM_MODEL=github-copilot/gpt-5.6-luna

# Optional: provider used when LLM_MODEL has no prefix (default: github-copilot)
# LLM_PROVIDER=github-copilot

# Deprecated alias for LLM_MODEL, still honoured when LLM_MODEL is unset.
# COPILOT_MODEL=github-copilot/gpt-5.6-luna

# Paths (defaults to ./knowledge and ./applications relative to project root)
# KNOWLEDGE_DIR=./knowledge
# APPLICATIONS_DIR=./applications

# Optional: explicit path to the copilot CLI executable
# COPILOT_CLI_PATH=C:\Users\jptrs\AppData\Roaming\npm\copilot.cmd

# Optional: attach to an already-running opencode server instead of spawning one
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# Optional: opencode agent to run prompts as (default: the server's default)
# OPENCODE_AGENT=build
