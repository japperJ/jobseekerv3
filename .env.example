# Copy to .env and adjust.
# Port for the local web app
PORT=4173

# Model used for all AI work, as <provider>/<model>.
# The provider prefix selects the backend: github-copilot (default) or opencode.
# The opencode prefix is followed by the provider and model *inside* opencode,
# e.g. opencode/opencode-go/space-bunny-free
LLM_MODEL=github-copilot/gpt-5.6-luna

# Optional: provider used when LLM_MODEL has no prefix (default: github-copilot)
# LLM_PROVIDER=github-copilot

# Deprecated alias for LLM_MODEL, still honoured when LLM_MODEL is unset.
# COPILOT_MODEL=github-copilot/gpt-5.6-luna

# Paths (defaults to ./knowledge and ./applications relative to project root)
# KNOWLEDGE_DIR=./knowledge
# APPLICATIONS_DIR=./applications

# Optional: explicit path to the copilot CLI executable
# COPILOT_CLI_PATH=C:\Users\jptrs\AppData\Roaming\npm\copilot.cmd

# opencode backend. The `opencode` CLI must be on PATH.
# By default the app spawns its own server on 127.0.0.1:4096 with a random
# password and a tool-free agent, and scopes sessions to a scratch directory.

# IMPORTANT when more than one opencode build is installed: the builds are not
# database-schema compatible, and on Windows a bare `opencode` resolves via
# PATHEXT and can pick the wrong one. Symptom: every prompt fails with
# "opencode prompt failed: Unexpected server error".
# OPENCODE_BIN=/full/path/to/opencode.exe

# Optional: attach to an already-running opencode server instead of spawning one
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# Optional: that server's Basic-auth password. Falls back to OPENCODE_SERVER_PASSWORD
# and then to the `password` in the CLI's ~/.config/opencode/service.json.
# OPENCODE_PASSWORD=
# Optional: opencode agent to run prompts as (default: a tool-free one for spawned servers)
# OPENCODE_AGENT=jobseeker
